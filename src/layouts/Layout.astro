---
import "../styles/global.css";
import CookieConsent from "../components/CookieConsent.astro";

interface Props {
  title: string;
  description: string;
  path?: string;
  locale?: "en" | "fi";
  translations?: { en: string; fi: string };
}

const { title, description, path = "/", locale = "en", translations } = Astro.props;
const canonicalURL = translations ? new URL(translations[locale], Astro.site) : new URL(path, Astro.site);
const ogImage = new URL("/images/redshielddefense-logo.png", Astro.site);
const ogLocale = locale === "fi" ? "fi_FI" : "en_IE";
const ogLocaleAlternate = locale === "fi" ? "en_IE" : "fi_FI";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />

    {translations && (
      <>
        <link rel="alternate" hreflang="en-EU" href={new URL(translations.en, Astro.site)} />
        <link rel="alternate" hreflang="fi-FI" href={new URL(translations.fi, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(translations.en, Astro.site)} />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="RedShield Defense" />
    <meta property="og:locale" content={ogLocale} />
    {translations && <meta property="og:locale:alternate" content={ogLocaleAlternate} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "@id": "https://redshielddefense.com/#organization",
      name: "RedShieldDefense",
      url: "https://redshielddefense.com",
      logo: "https://redshielddefense.com/images/redshielddefense-logo.png",
      image: "https://redshielddefense.com/images/redshielddefense-logo.png",
      description:
        "RedShieldDefense provides VAPT (Vulnerability Assessment and Penetration Testing) and offensive security services helping EU businesses meet NIS2 and CRA compliance requirements.",
      areaServed: "European Union",
      knowsAbout: ["VAPT", "Penetration Testing", "NIS2 Compliance", "CRA Compliance", "Cybersecurity"],
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "sales",
        email: "info@redshielddefense.com",
        areaServed: "EU",
        availableLanguage: ["English", "Finnish"],
      },
      parentOrganization: {
        "@type": "Organization",
        name: "Cyber Security Finland Oy",
        url: "https://cybersecurity.fi",
      },
      sameAs: ["https://cybersecurity.fi"],
    })} />
  </head>
  <body class="bg-rsd-bg text-rsd-body antialiased">
    <slot />
    <CookieConsent locale={locale} />
  </body>
</html>
