---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";
---

<Layout
  title="Contact Us | RedShield Defense"
  description="Get in touch with RedShield Defense for security assessments, partnership inquiries, or general questions."
  path="/company/contact"
>
  <Header />
  <main>
    <PageHero
      eyebrow="Company"
      title="Talk to our team."
      desc="Whether you're scoping an assessment or just have a question, we'll route you to the right engineer."
      breadcrumb={[{ name: "Company", href: "/company" }, { name: "Contact", href: "/company/contact" }]}
    />

    <section class="bg-rsd-bg py-20">
      <div class="mx-auto grid max-w-7xl grid-cols-1 gap-16 px-6 lg:grid-cols-5">
        <div class="lg:col-span-2">
          <h2 class="font-display text-2xl font-bold text-rsd-heading">Other ways to reach us</h2>
          <dl class="mt-8 space-y-8">
            <div>
              <dt class="eyebrow">General Inquiries</dt>
              <dd class="mt-2 text-rsd-body-bright"><a href="mailto:hello@redshielddefense.com" class="hover:text-rsd-cyan">hello@redshielddefense.com</a></dd>
            </div>
            <div>
              <dt class="eyebrow">New Assessments</dt>
              <dd class="mt-2 text-rsd-body-bright"><a href="mailto:assessments@redshielddefense.com" class="hover:text-rsd-cyan">assessments@redshielddefense.com</a></dd>
            </div>
            <div>
              <dt class="eyebrow">Security Disclosure</dt>
              <dd class="mt-2 text-rsd-body-bright"><a href="/legal/responsible-disclosure" class="hover:text-rsd-cyan">View our disclosure policy</a></dd>
            </div>
            <div>
              <dt class="eyebrow">Headquarters</dt>
              <dd class="mt-2 text-rsd-body-bright">Austin, Texas · Remote-first team across US &amp; EU</dd>
            </div>
          </dl>
        </div>

        <div class="lg:col-span-3">
          <form id="contact-form" class="rounded-xl border border-rsd-border bg-rsd-surface p-8">
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-2 block text-sm font-medium text-rsd-body-bright">Full Name</label>
                <input required id="name" name="name" type="text" class="w-full rounded-md border border-rsd-border bg-rsd-bg px-4 py-3 text-rsd-heading placeholder:text-rsd-body/60 focus:border-rsd-cyan focus:outline-none" placeholder="Jordan Smith" />
              </div>
              <div>
                <label for="email" class="mb-2 block text-sm font-medium text-rsd-body-bright">Work Email</label>
                <input required id="email" name="email" type="email" class="w-full rounded-md border border-rsd-border bg-rsd-bg px-4 py-3 text-rsd-heading placeholder:text-rsd-body/60 focus:border-rsd-cyan focus:outline-none" placeholder="jordan@company.com" />
              </div>
            </div>
            <div class="mt-6">
              <label for="company" class="mb-2 block text-sm font-medium text-rsd-body-bright">Company</label>
              <input required id="company" name="company" type="text" class="w-full rounded-md border border-rsd-border bg-rsd-bg px-4 py-3 text-rsd-heading placeholder:text-rsd-body/60 focus:border-rsd-cyan focus:outline-none" placeholder="Acme Corp" />
            </div>
            <div class="mt-6">
              <label for="message" class="mb-2 block text-sm font-medium text-rsd-body-bright">Message</label>
              <textarea required id="message" name="message" rows="5" class="w-full rounded-md border border-rsd-border bg-rsd-bg px-4 py-3 text-rsd-heading placeholder:text-rsd-body/60 focus:border-rsd-cyan focus:outline-none" placeholder="Tell us about what you're looking to secure."></textarea>
            </div>
            <button type="submit" class="btn-primary mt-8 w-full justify-center sm:w-auto">Send Message</button>
            <p id="contact-status" class="mt-4 hidden text-sm text-rsd-cyan" role="status"></p>
          </form>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("contact-status");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (status) {
      status.textContent = "Thanks — this form is a design preview and isn't yet connected to a mailbox. Please email hello@redshielddefense.com directly.";
      status.classList.remove("hidden");
    }
  });
</script>
