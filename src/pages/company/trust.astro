---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";
import { icons } from "../../data/icons";

const certifications = [
  { name: "SOC 2 Type II", desc: "Independently audited controls covering security, availability, and confidentiality of our own systems." },
  { name: "ISO 27001", desc: "Certified information security management system governing how we handle client data and findings." },
  { name: "GDPR & CCPA Aligned", desc: "Data handling practices aligned to major privacy regulations across the regions we operate in." },
];

const practices = [
  { icon: "shield-check", title: "Encrypted Findings Delivery", desc: "All assessment findings and client data are encrypted in transit and at rest, delivered through access-controlled portals." },
  { icon: "layers", title: "Least-Privilege Internal Access", desc: "Client engagement data is scoped to the specific engineering team assigned, on a need-to-know basis." },
  { icon: "radar", title: "Continuous Internal Monitoring", desc: "Our own infrastructure is monitored by the same Threat Operations Center that protects our clients." },
];
---

<Layout
  title="Trust & Certifications | RedShield Defense"
  description="RedShield Defense's own security certifications, data handling practices, and responsible disclosure program."
  path="/company/trust"
>
  <Header />
  <main>
    <PageHero
      eyebrow="Trust"
      title="We hold ourselves to the standard we test you against."
      desc="Security is our product, which means our own posture is held to the same rigor as any client engagement."
      breadcrumb={[{ name: "Company", href: "/company" }, { name: "Trust & Certifications", href: "/company/trust" }]}
    />

    <section class="border-b border-rsd-border bg-rsd-bg py-20">
      <div class="mx-auto max-w-7xl px-6">
        <p class="eyebrow mb-4">Certifications</p>
        <h2 class="font-display text-3xl font-bold text-rsd-heading sm:text-4xl">Independently verified.</h2>
        <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
          {certifications.map((cert) => (
            <div class="rounded-lg border border-rsd-border bg-rsd-surface p-7">
              <div class="flex h-11 w-11 items-center justify-center rounded-md border border-rsd-border bg-rsd-bg text-rsd-cyan">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" set:html={icons["shield-check"]} />
              </div>
              <h3 class="mt-5 font-display text-lg font-semibold text-rsd-heading">{cert.name}</h3>
              <p class="mt-3 text-sm leading-relaxed text-rsd-body">{cert.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-rsd-border bg-rsd-surface-alt py-20">
      <div class="mx-auto max-w-7xl px-6">
        <p class="eyebrow mb-4">How We Protect Your Data</p>
        <h2 class="font-display text-3xl font-bold text-rsd-heading sm:text-4xl">Practices, not just policy.</h2>
        <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
          {practices.map((practice) => (
            <div class="rounded-lg border border-rsd-border bg-rsd-surface p-7">
              <div class="flex h-11 w-11 items-center justify-center rounded-md border border-rsd-border bg-rsd-bg text-rsd-cyan">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" set:html={icons[practice.icon]} />
              </div>
              <h3 class="mt-5 font-display text-lg font-semibold text-rsd-heading">{practice.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-rsd-body">{practice.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-rsd-border bg-rsd-bg py-16">
      <div class="mx-auto max-w-4xl px-6 text-center">
        <h2 class="font-display text-2xl font-bold text-rsd-heading">Found a vulnerability in our own systems?</h2>
        <p class="mt-4 text-rsd-body">We run our own responsible disclosure program and welcome external review.</p>
        <a href="/legal/responsible-disclosure" class="btn-ghost mt-6 inline-flex">View Responsible Disclosure Policy</a>
      </div>
    </section>

    <CtaBand />
  </main>
  <Footer />
</Layout>
