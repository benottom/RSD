---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";

const values = [
  { title: "Operate Like the Adversary", desc: "We test and defend using the same tradecraft real attackers use — not a checklist derived from a compliance framework." },
  { title: "Precision Over Noise", desc: "Every finding is validated and prioritized by real exploitability, so your team spends time fixing risk, not triaging false positives." },
  { title: "Engineer, Don't Just Report", desc: "We hand off remediation guidance your engineers can implement directly, and stay engaged through retesting." },
  { title: "Earn Trust Through Rigor", desc: "Mission-critical organizations don't need reassurance — they need evidence. We build our reputation one validated finding at a time." },
];

const stats = [
  { value: "2016", label: "Founded" },
  { value: "60+", label: "Security engineers on staff" },
  { value: "400+", label: "Organizations secured" },
  { value: "17 yrs", label: "Combined offensive security expertise" },
];
---

<Layout
  title="About RedShield Defense | Industrial-Grade Security"
  description="RedShield Defense is a security firm built by offensive security engineers, delivering industrial-grade protection for mission-critical infrastructure."
  path="/company"
  locale="en"
  translations={{ en: "/company", fi: "/fi/company" }}
>
  <Header fiHref="/fi/company" />
  <main>
    <PageHero
      eyebrow="Company"
      title="Built by engineers who've operated on both sides of the assessment."
      desc="RedShield Defense was founded on a simple premise: security testing should be conducted with the same rigor, patience, and tradecraft as a real intrusion — because that's the only way to find what actually matters."
      breadcrumb={[{ name: "Company", href: "/company" }]}
    />

    <section class="border-b border-rsd-border bg-rsd-bg py-20">
      <div class="mx-auto max-w-4xl px-6">
        <p class="text-lg leading-relaxed text-rsd-body-bright">
          RedShield Defense started with a frustration, not a business plan. We'd spent years running offensive engagements for other firms, watching the same story play out: six-figure security budgets, a stack of tools nobody had time to tune, and the actual doors in — a forgotten admin panel, an IAM role nobody remembered granting, a staging environment left open to the internet — sitting wide open the whole time.
        </p>
        <p class="mt-6 text-lg leading-relaxed text-rsd-body-bright">
          So in 2016 we started doing it differently: fewer boxes ticked, more doors actually tested. That's still the whole pitch. We now run offensive assessments, defensive engineering, and managed detection for organizations in financial services, healthcare, critical infrastructure, and technology — but the question we ask on day one of every engagement hasn't changed: if someone actually wanted in, where would they go first?
        </p>
      </div>
    </section>

    <section class="border-b border-rsd-border bg-rsd-bg-deep py-16">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <p class="font-display text-2xl font-semibold leading-snug text-white sm:text-3xl">
          "If a finding doesn't have a working proof-of-concept, it's not a finding — it's a guess."
        </p>
        <p class="mt-4 font-mono text-xs uppercase tracking-widest text-rsd-cyan">Our engineering standard, since day one</p>
      </div>
    </section>

    <section class="border-b border-rsd-border bg-rsd-surface-alt py-20">
      <div class="mx-auto max-w-7xl px-6">
        <p class="eyebrow mb-4">What We Believe</p>
        <h2 class="font-display text-3xl font-bold text-rsd-heading sm:text-4xl">Principles that shape every engagement.</h2>
        <div class="mt-12 grid grid-cols-1 gap-x-12 gap-y-10 md:grid-cols-2">
          {values.map((value, i) => (
            <div class="flex gap-5">
              <span class="font-display text-3xl font-bold text-rsd-border-bright/15 sm:text-4xl">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="font-display text-lg font-semibold text-rsd-heading">{value.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-rsd-body">{value.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-rsd-border bg-rsd-bg py-16">
      <div class="mx-auto max-w-5xl px-6">
        <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
          {stats.map((stat) => (
            <div class="text-center">
              <p class="font-display text-3xl font-bold text-rsd-heading">{stat.value}</p>
              <p class="mt-2 text-sm text-rsd-body">{stat.label}</p>
            </div>
          ))}
        </div>
        <p class="mt-8 text-center font-mono text-xs text-rsd-body/70">No fundraising, no acquisitions — just the same team, ten years in.</p>
      </div>
    </section>

    <CtaBand />
  </main>
  <Footer />
</Layout>
