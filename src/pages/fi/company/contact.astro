---
import Layout from "../../../layouts/Layout.astro";
import FiHeader from "../../../components/FiHeader.astro";
import FiFooter from "../../../components/FiFooter.astro";
import PageHero from "../../../components/PageHero.astro";
---

<Layout
  title="Ota yhteyttä | RedShield Defense"
  description="Ota yhteyttä RedShield Defenseen tietoturva-arviointeja, yhteistyömahdollisuuksia tai yleisiä kysymyksiä varten."
  path="/fi/company/contact"
  locale="fi"
  translations={{ en: "/company/contact", fi: "/fi/company/contact" }}
>
  <FiHeader enHref="/company/contact" />
  <main>
    <PageHero
      eyebrow="Yritys"
      title="Keskustele tiimimme kanssa."
      desc="Olitpa rajaamassa arviointia tai vain kysymässä jotain, ohjaamme teidät oikean asiantuntijan puheille."
      breadcrumb={[{ name: "Yritys", href: "/fi/company" }, { name: "Ota yhteyttä", href: "/fi/company/contact" }]}
    />

    <section class="bg-rsd-bg py-20">
      <div class="mx-auto grid max-w-7xl grid-cols-1 gap-16 px-6 lg:grid-cols-5">
        <div class="lg:col-span-2">
          <h2 class="font-display text-2xl font-bold text-rsd-heading">Muut tavat tavoittaa meidät</h2>
          <dl class="mt-8 space-y-8">
            <div>
              <dt class="eyebrow">Yleiset tiedustelut</dt>
              <dd class="mt-2 text-rsd-body-bright"><a href="mailto:info@redshielddefense.com" class="hover:text-rsd-cyan">info@redshielddefense.com</a></dd>
            </div>
            <div>
              <dt class="eyebrow">Tietoturvailmoitus</dt>
              <dd class="mt-2 text-rsd-body-bright"><a href="/fi/legal/vastuullinen-tietoturvailmoitus" class="hover:text-rsd-cyan">Katso ilmoituskäytäntömme</a></dd>
            </div>
          </dl>
        </div>

        <div class="lg:col-span-3">
          <form id="contact-form" action="https://formspree.io/f/xzepvdda" method="POST" class="rounded-xl border border-rsd-border bg-rsd-surface p-8">
            <input type="hidden" name="_subject" value="Uusi yhteydenotto (FI) — RedShield Defense" />
            <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-2 block text-sm font-medium text-rsd-body-bright">Koko nimi</label>
                <input required id="name" name="name" type="text" class="w-full rounded-md border border-rsd-border bg-rsd-bg px-4 py-3 text-rsd-heading placeholder:text-rsd-body/60 focus:border-rsd-cyan focus:outline-none" placeholder="Matti Meikäläinen" />
              </div>
              <div>
                <label for="email" class="mb-2 block text-sm font-medium text-rsd-body-bright">Työsähköposti</label>
                <input required id="email" name="email" type="email" class="w-full rounded-md border border-rsd-border bg-rsd-bg px-4 py-3 text-rsd-heading placeholder:text-rsd-body/60 focus:border-rsd-cyan focus:outline-none" placeholder="matti@yritys.fi" />
              </div>
            </div>
            <div class="mt-6">
              <label for="company" class="mb-2 block text-sm font-medium text-rsd-body-bright">Yritys</label>
              <input required id="company" name="company" type="text" class="w-full rounded-md border border-rsd-border bg-rsd-bg px-4 py-3 text-rsd-heading placeholder:text-rsd-body/60 focus:border-rsd-cyan focus:outline-none" placeholder="Esimerkki Oy" />
            </div>
            <div class="mt-6">
              <label for="message" class="mb-2 block text-sm font-medium text-rsd-body-bright">Viesti</label>
              <textarea required id="message" name="message" rows="5" class="w-full rounded-md border border-rsd-border bg-rsd-bg px-4 py-3 text-rsd-heading placeholder:text-rsd-body/60 focus:border-rsd-cyan focus:outline-none" placeholder="Kerro, mitä haluaisitte suojata."></textarea>
            </div>
            <button type="submit" class="btn-primary mt-8 w-full justify-center sm:w-auto">Lähetä viesti</button>
            <p id="contact-status" class="mt-4 hidden text-sm" role="status"></p>
          </form>
        </div>
      </div>
    </section>
  </main>
  <FiFooter />
</Layout>

<script>
  import { track } from "@vercel/analytics";

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("contact-status");
  const submitButton = form?.querySelector("button[type=submit]") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status || !submitButton) return;

    submitButton.disabled = true;
    submitButton.classList.add("opacity-60");
    status.classList.remove("hidden", "text-rsd-cyan", "text-red-600");

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      if (response.ok) {
        status.textContent = "Kiitos — viestinne on lähetetty. Olemme yhteydessä yhden arkipäivän kuluessa.";
        status.classList.add("text-rsd-cyan");
        track("contact_form_submit");
        form.reset();
      } else {
        status.textContent = "Viestin lähetys epäonnistui. Lähettäkää sähköpostia osoitteeseen info@redshielddefense.com.";
        status.classList.add("text-red-600");
      }
    } catch {
      status.textContent = "Viestin lähetys epäonnistui. Lähettäkää sähköpostia osoitteeseen info@redshielddefense.com.";
      status.classList.add("text-red-600");
    } finally {
      submitButton.disabled = false;
      submitButton.classList.remove("opacity-60");
    }
  });
</script>
