---
import Layout from "../../../layouts/Layout.astro";
import FiHeader from "../../../components/FiHeader.astro";
import FiFooter from "../../../components/FiFooter.astro";
import FiCtaBand from "../../../components/FiCtaBand.astro";
import PageHero from "../../../components/PageHero.astro";
import { servicesFi } from "../../../data/services.fi";
import { icons } from "../../../data/icons";
---

<Layout
  title="Tietoturvapalvelut | RedShield Defense"
  description="Kokonaisvaltaiset offensiiviset ja defensiiviset tietoturvapalvelut: tunkeutumistestaus, pilviturvallisuus, koodikatselmointi, hallinnoitu SecOps, vaatimustenmukaisuus ja red team -operaatiot."
  path="/fi/services"
  locale="fi"
  translations={{ en: "/services", fi: "/fi/services" }}
>
  <FiHeader />
  <main>
    <PageHero
      eyebrow="Ratkaisut"
      title="Kokonaisvaltaisia tietoturvapalveluita liiketoimintakriittiselle infrastruktuurille."
      desc="Offensiivisesta testauksesta jatkuvaan puolustukseen — RedShield Defense toimii tietoturvatoimintonne jatkeena."
      breadcrumb={[{ name: "Palvelut", href: "/fi/services" }]}
    />

    <section class="border-b border-rsd-border bg-rsd-bg py-20">
      <div class="mx-auto max-w-7xl px-6">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {servicesFi.map((service) => (
            <a href={`/fi/services/${service.slug}`} class="glow-border group flex flex-col rounded-lg border border-rsd-border bg-rsd-surface p-8">
              <div class="flex h-12 w-12 items-center justify-center rounded-md border border-rsd-border bg-rsd-bg text-rsd-cyan">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" set:html={icons[service.icon]} />
              </div>
              <p class="eyebrow mt-6">{service.tag}</p>
              <h2 class="mt-3 font-display text-xl font-semibold text-rsd-heading">{service.name}</h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-rsd-body">{service.shortDesc}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-rsd-cyan">
                Katso palvelun tiedot
                <svg class="transition-transform group-hover:translate-x-1" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <FiCtaBand />
  </main>
  <FiFooter />
</Layout>
