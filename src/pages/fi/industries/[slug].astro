---
import Layout from "../../../layouts/Layout.astro";
import FiHeader from "../../../components/FiHeader.astro";
import FiFooter from "../../../components/FiFooter.astro";
import FiCtaBand from "../../../components/FiCtaBand.astro";
import PageHero from "../../../components/PageHero.astro";
import { industriesFi } from "../../../data/industries.fi";
import { servicesFi, getServiceFiByEnSlug } from "../../../data/services.fi";
import { icons } from "../../../data/icons";

export function getStaticPaths() {
  return industriesFi.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

const { industry } = Astro.props;
const relatedServices = industry.relatedServices.map((enSlug: string) => getServiceFiByEnSlug(enSlug)).filter(Boolean);
---

<Layout
  title={`${industry.name} – tietoturva | RedShield Defense`}
  description={industry.shortDesc}
  path={`/fi/industries/${industry.slug}`}
  locale="fi"
  translations={{ en: `/industries/${industry.enSlug}`, fi: `/fi/industries/${industry.slug}` }}
>
  <FiHeader enHref={`/industries/${industry.enSlug}`} />
  <main>
    <PageHero
      eyebrow="Toimialat"
      title={`${industry.name} – tietoturva`}
      desc={industry.heroDesc}
      breadcrumb={[{ name: "Toimialat", href: "/fi/industries" }, { name: industry.name, href: `/fi/industries/${industry.slug}` }]}
    />

    <section class="border-b border-rsd-border bg-rsd-bg py-20">
      <div class="mx-auto max-w-4xl px-6">
        <div class="flex h-14 w-14 items-center justify-center rounded-md border border-rsd-border bg-rsd-surface text-rsd-cyan">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" set:html={icons[industry.icon]} />
        </div>
        {industry.approach.map((paragraph: string) => (
          <p class="mt-6 text-lg leading-relaxed text-rsd-body-bright">{paragraph}</p>
        ))}
      </div>
    </section>

    <section class="border-b border-rsd-border bg-rsd-surface-alt py-20">
      <div class="mx-auto max-w-7xl px-6">
        <p class="eyebrow mb-4">Toimialan haasteet</p>
        <h2 class="font-display text-3xl font-bold text-rsd-heading sm:text-4xl">Mikä tekee {industry.name.toLowerCase()}-alasta erilaisen.</h2>
        <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
          {industry.challenges.map((challenge: { title: string; desc: string }) => (
            <div class="rounded-lg border border-rsd-border bg-rsd-surface p-7">
              <h3 class="font-display text-lg font-semibold text-rsd-heading">{challenge.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-rsd-body">{challenge.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-rsd-border bg-rsd-bg py-20">
      <div class="mx-auto max-w-7xl px-6">
        <p class="eyebrow mb-4">Suositellut palvelut</p>
        <h2 class="font-display text-3xl font-bold text-rsd-heading sm:text-4xl">Mistä aloittaa.</h2>
        <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
          {relatedServices.map((service: (typeof servicesFi)[number]) => (
            <a href={`/fi/services/${service.slug}`} class="glow-border group flex flex-col rounded-lg border border-rsd-border bg-rsd-surface p-7">
              <div class="flex h-11 w-11 items-center justify-center rounded-md border border-rsd-border bg-rsd-bg text-rsd-cyan">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" set:html={icons[service.icon]} />
              </div>
              <h3 class="mt-5 font-display text-base font-semibold text-rsd-heading">{service.name}</h3>
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-rsd-cyan">
                Katso palvelun tiedot
                <svg class="transition-transform group-hover:translate-x-1" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <FiCtaBand />
  </main>
  <FiFooter />
</Layout>
