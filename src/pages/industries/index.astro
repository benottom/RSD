---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";
import { industries } from "../../data/industries";
import { icons } from "../../data/icons";
---

<Layout
  title="Industries | RedShield Defense"
  description="Sector-specific security expertise for financial services, healthcare, SaaS, critical infrastructure, government, and e-commerce organizations."
  path="/industries"
>
  <Header />
  <main>
    <PageHero
      eyebrow="Industries"
      title="Sector-specific expertise, not generic playbooks."
      desc="Every industry carries a different threat model, regulatory burden, and tolerance for disruption. We tailor engagements accordingly."
      breadcrumb={[{ name: "Industries", href: "/industries" }]}
    />

    <section class="border-b border-rsd-border bg-rsd-bg py-20">
      <div class="mx-auto max-w-7xl px-6">
        <div class="grid grid-cols-1 divide-y divide-rsd-border border-y border-rsd-border sm:grid-cols-2 sm:divide-x sm:divide-y-0 lg:grid-cols-3">
          {industries.map((industry) => (
            <a href={`/industries/${industry.slug}`} class="group flex flex-col gap-4 p-8 transition-colors hover:bg-rsd-surface/60">
              <div class="flex h-11 w-11 items-center justify-center rounded-md border border-rsd-border bg-rsd-surface text-rsd-cyan">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" set:html={icons[industry.icon]} />
              </div>
              <h2 class="font-display text-lg font-semibold text-rsd-heading group-hover:text-rsd-cyan">{industry.name}</h2>
              <p class="text-sm leading-relaxed text-rsd-body">{industry.shortDesc}</p>
              <span class="inline-flex items-center gap-2 text-sm font-semibold text-rsd-cyan opacity-0 transition-opacity group-hover:opacity-100">
                Learn About This Sector
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <CtaBand />
  </main>
  <Footer />
</Layout>
