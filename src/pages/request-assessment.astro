---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import { services } from "../data/services";
import { industries } from "../data/industries";

const reassurances = [
  { title: "1 business day", desc: "Average response time to new assessment requests." },
  { title: "NDA-first", desc: "A mutual NDA is signed before any scoping details are shared." },
  { title: "No obligation", desc: "Scoping calls are consultative — you decide if and when to move forward." },
];

const faqs = [
  {
    q: "Will testing disrupt our production systems?",
    a: "Testing windows and rules of engagement are agreed with you before any active testing begins — that's step one of the process below. Engagements are scheduled around your traffic patterns and change windows, not ours.",
  },
  {
    q: "What happens to our data during the engagement?",
    a: "A mutual NDA is signed before any scoping details are shared. Engagement data is scoped to the specific engineering team assigned, on a need-to-know basis, and all findings are encrypted in transit and at rest and delivered through an access-controlled portal.",
  },
  {
    q: "Who owns the report afterward, and is it ever shared?",
    a: "The report and every finding in it are yours. It's delivered through the access-controlled portal above and is never referenced or reused for another client.",
  },
  {
    q: "Can we see a sample report before we commit?",
    a: "Ask during your scoping call — we're glad to walk through a redacted example so you know exactly what to expect before you decide anything.",
  },
  {
    q: "Is retesting included if you find something critical?",
    a: "Yes. Every critical and high finding is retested at no additional cost until remediation is confirmed.",
  },
  {
    q: "How long does an engagement actually take?",
    a: "It depends on scope — a focused web application test can run days, a full red team engagement runs weeks. Your proposal will include an exact timeline before you're asked to commit to anything.",
  },
];
---

<Layout
  title="Request an Assessment | RedShield Defense"
  description="Request a tailored security assessment from RedShield Defense, scoped to your environment, industry, and risk posture."
  path="/request-assessment"
  locale="en"
  translations={{ en: "/request-assessment", fi: "/fi/request-assessment" }}
>
  <Header fiHref="/fi/request-assessment" />
  <main>
    <PageHero
      eyebrow="Get Started"
      title="Request a Threat Assessment"
      desc="Tell us about your environment and we'll come back with a scoped engagement proposal — no generic packages, no obligation."
      breadcrumb={[{ name: "Request an Assessment", href: "/request-assessment" }]}
    />

    <section class="bg-rsd-bg py-20">
      <div class="mx-auto grid max-w-7xl grid-cols-1 gap-16 px-6 lg:grid-cols-5">
        <div class="lg:col-span-2">
          <h2 class="font-display text-2xl font-bold text-rsd-heading">What happens next</h2>
          <ol class="mt-8 space-y-8">
            <li class="border-l-2 border-rsd-cyan/40 pl-6">
              <span class="font-mono text-sm text-rsd-cyan">01</span>
              <h3 class="mt-2 font-display text-lg font-semibold text-rsd-heading">We review your request</h3>
              <p class="mt-2 text-sm leading-relaxed text-rsd-body">A senior engineer reviews your environment details within one business day.</p>
            </li>
            <li class="border-l-2 border-rsd-cyan/40 pl-6">
              <span class="font-mono text-sm text-rsd-cyan">02</span>
              <h3 class="mt-2 font-display text-lg font-semibold text-rsd-heading">Scoping call</h3>
              <p class="mt-2 text-sm leading-relaxed text-rsd-body">A short call to understand your systems, timeline, and objectives — under NDA.</p>
            </li>
            <li class="border-l-2 border-rsd-cyan/40 pl-6">
              <span class="font-mono text-sm text-rsd-cyan">03</span>
              <h3 class="mt-2 font-display text-lg font-semibold text-rsd-heading">Proposal & scheduling</h3>
              <p class="mt-2 text-sm leading-relaxed text-rsd-body">A tailored proposal with pricing and timeline, ready to schedule when you are.</p>
            </li>
          </ol>

          <div class="mt-12 space-y-6 border-t border-rsd-border pt-10">
            {reassurances.map((item) => (
              <div class="flex gap-4">
                <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-rsd-cyan"></span>
                <div>
                  <p class="font-display font-semibold text-rsd-heading">{item.title}</p>
                  <p class="text-sm text-rsd-body">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="mt-10 rounded-lg border border-rsd-border bg-rsd-surface p-6">
            <p class="font-display font-semibold text-rsd-heading">Not ready to talk yet?</p>
            <p class="mt-2 text-sm leading-relaxed text-rsd-body">Check your NIS2 &amp; CRA exposure first — a free, 12-question self-assessment with an instant result.</p>
            <a href="/nis2-readiness-check" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-rsd-cyan">
              Take the Readiness Check
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>

        <div class="lg:col-span-3">
          <form id="assessment-form" action="https://formspree.io/f/xzepvdda" method="POST" class="rounded-xl border border-rsd-border bg-rsd-surface p-8">
            <input type="hidden" name="_subject" value="New assessment request — RedShield Defense" />
            <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-2 block text-sm font-medium text-rsd-body-bright">Full Name</label>
                <input required id="name" name="name" type="text" class="w-full rounded-md border border-rsd-border bg-rsd-bg px-4 py-3 text-rsd-heading placeholder:text-rsd-body/60 focus:border-rsd-cyan focus:outline-none" placeholder="Jordan Smith" />
              </div>
              <div>
                <label for="email" class="mb-2 block text-sm font-medium text-rsd-body-bright">Work Email</label>
                <input required id="email" name="email" type="email" class="w-full rounded-md border border-rsd-border bg-rsd-bg px-4 py-3 text-rsd-heading placeholder:text-rsd-body/60 focus:border-rsd-cyan focus:outline-none" placeholder="jordan@company.com" />
              </div>
            </div>

            <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <label for="company" class="mb-2 block text-sm font-medium text-rsd-body-bright">Company</label>
                <input required id="company" name="company" type="text" class="w-full rounded-md border border-rsd-border bg-rsd-bg px-4 py-3 text-rsd-heading placeholder:text-rsd-body/60 focus:border-rsd-cyan focus:outline-none" placeholder="Acme Corp" />
              </div>
              <div>
                <label for="industry" class="mb-2 block text-sm font-medium text-rsd-body-bright">Industry</label>
                <select id="industry" name="industry" class="w-full rounded-md border border-rsd-border bg-rsd-bg px-4 py-3 text-rsd-heading focus:border-rsd-cyan focus:outline-none">
                  <option value="">Select an industry</option>
                  {industries.map((industry) => <option value={industry.slug}>{industry.name}</option>)}
                  <option value="other">Other</option>
                </select>
              </div>
            </div>

            <fieldset class="mt-6">
              <legend class="mb-3 block text-sm font-medium text-rsd-body-bright">Services of Interest</legend>
              <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                {services.map((service) => (
                  <label class="flex items-center gap-2.5 rounded-md border border-rsd-border bg-rsd-bg px-4 py-3 text-sm text-rsd-body-bright has-[:checked]:border-rsd-cyan has-[:checked]:text-rsd-heading">
                    <input type="checkbox" name="services" value={service.slug} class="accent-rsd-cyan" />
                    {service.shortName}
                  </label>
                ))}
              </div>
            </fieldset>

            <div class="mt-6">
              <label for="message" class="mb-2 block text-sm font-medium text-rsd-body-bright">Tell us about your environment</label>
              <textarea id="message" name="message" rows="5" class="w-full rounded-md border border-rsd-border bg-rsd-bg px-4 py-3 text-rsd-heading placeholder:text-rsd-body/60 focus:border-rsd-cyan focus:outline-none" placeholder="What systems are in scope? Any timeline or compliance deadline we should know about?"></textarea>
            </div>

            <button type="submit" class="btn-primary mt-8 w-full justify-center">
              Submit Request
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <p id="assessment-status" class="mt-4 hidden text-sm" role="status"></p>
          </form>
        </div>
      </div>
    </section>

    <section class="border-t border-rsd-border bg-rsd-surface-alt py-20">
      <div class="mx-auto max-w-3xl px-6">
        <p class="eyebrow mb-4">Before You Submit</p>
        <h2 class="font-display text-3xl font-bold text-rsd-heading sm:text-4xl">Questions we get on every scoping call.</h2>
        <div class="mt-10 divide-y divide-rsd-border border-y border-rsd-border">
          {faqs.map((item) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-semibold text-rsd-heading">
                {item.q}
                <svg class="h-4 w-4 shrink-0 text-rsd-cyan transition-transform group-open:rotate-45" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 3V13M3 8H13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              </summary>
              <p class="mt-3 max-w-2xl text-sm leading-relaxed text-rsd-body">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  import { track } from "@vercel/analytics";

  const form = document.getElementById("assessment-form") as HTMLFormElement | null;
  const status = document.getElementById("assessment-status");
  const submitButton = form?.querySelector("button[type=submit]") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status || !submitButton) return;

    submitButton.disabled = true;
    submitButton.classList.add("opacity-60");
    status.classList.remove("hidden", "text-rsd-cyan", "text-red-600");

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      if (response.ok) {
        status.textContent = "Thanks — your request has been sent. A senior engineer will review it within one business day.";
        status.classList.add("text-rsd-cyan");
        track("assessment_form_submit");
        form.reset();
      } else {
        status.textContent = "Something went wrong sending your request. Please email assessments@redshielddefense.com directly.";
        status.classList.add("text-red-600");
      }
    } catch {
      status.textContent = "Something went wrong sending your request. Please email assessments@redshielddefense.com directly.";
      status.classList.add("text-red-600");
    } finally {
      submitButton.disabled = false;
      submitButton.classList.remove("opacity-60");
    }
  });
</script>
