---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import ThreatIntel from "../components/ThreatIntel.astro";
import Industries from "../components/Industries.astro";
import ResourcesTeaser from "../components/ResourcesTeaser.astro";
import CtaBand from "../components/CtaBand.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="VAPT Services for EU NIS2 & CRA Compliance | RedShield"
  description="EU-based penetration testing & VAPT to help you meet NIS2 and CRA requirements. Certified experts, audit-ready reports — request your assessment."
  path="/"
  locale="en"
  translations={{ en: "/", fi: "/fi/" }}
>
  <Header switchTo={{ label: "Suomeksi", href: "/fi/" }} />
  <main>
    <Hero />
    <Services />
    <ThreatIntel />
    <Industries />
    <ResourcesTeaser />
    <CtaBand />
  </main>
  <Footer />
</Layout>
