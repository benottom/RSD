---
import type { ResourceItem } from "../data/resources";

interface Props {
  item: ResourceItem;
  href: string;
  ctaLabel: string;
}

const { item, href, ctaLabel } = Astro.props;
---

<a href={href} class="glow-border group flex flex-col rounded-lg border border-rsd-border bg-rsd-surface p-8">
  <div class="flex items-center justify-between">
    <span class="eyebrow">{item.kind}</span>
    <span class="font-mono text-xs text-rsd-body">{item.readTime}</span>
  </div>
  <h3 class="mt-4 font-display text-xl font-semibold text-rsd-heading">{item.title}</h3>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-rsd-body">{item.excerpt}</p>
  <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-rsd-cyan">
    {ctaLabel}
    <svg class="transition-transform group-hover:translate-x-1" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </span>
</a>
