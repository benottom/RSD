---
interface Props {
  switchTo?: { label: string; href: string };
}

const { switchTo } = Astro.props;
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-all duration-300">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 transition-all duration-300" id="header-inner">
    <a href="/fi/" class="flex items-center shrink-0">
      <img src="/images/redshielddefense-logo.png" alt="RedShield Defense" width="108" height="132" class="h-[108px] w-auto" loading="eager" decoding="async" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex">
      <a href="/fi/services/tunkeutumistestaus" class="px-4 py-2 text-sm font-medium text-rsd-body-bright transition-colors hover:text-rsd-cyan">VAPT-palvelu</a>
      <a href="/company/contact" class="px-4 py-2 text-sm font-medium text-rsd-body-bright transition-colors hover:text-rsd-cyan">Ota yhteyttä</a>
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      {switchTo && (
        <a href={switchTo.href} lang="en" class="text-sm font-medium text-rsd-body transition-colors hover:text-rsd-cyan">{switchTo.label}</a>
      )}
      <a href="/request-assessment" class="btn-primary text-sm">Pyydä arviointi</a>
    </div>

    <button id="mobile-menu-toggle" aria-label="Avaa valikko" aria-expanded="false" class="flex h-10 w-10 items-center justify-center lg:hidden">
      <svg id="icon-burger" width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M2 5.5H20M2 11H20M2 16.5H20" stroke="white" stroke-width="1.6" stroke-linecap="round"/></svg>
      <svg id="icon-close" width="22" height="22" viewBox="0 0 22 22" fill="none" class="hidden"><path d="M4 4L18 18M18 4L4 18" stroke="white" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu fixed inset-0 z-40 flex flex-col bg-rsd-bg-deep px-6 pb-10 pt-28 lg:hidden">
  <div class="grid-overlay pointer-events-none absolute inset-0 opacity-40"></div>
  <nav class="relative flex flex-1 flex-col justify-center gap-2">
    <a href="/fi/services/tunkeutumistestaus" class="mobile-menu-item font-display text-3xl font-semibold text-white" style="transition-delay:60ms">VAPT-palvelu</a>
    <a href="/company/contact" class="mobile-menu-item font-display text-3xl font-semibold text-white" style="transition-delay:120ms">Ota yhteyttä</a>
    {switchTo && (
      <a href={switchTo.href} lang="en" class="mobile-menu-item font-display text-3xl font-semibold text-white" style="transition-delay:180ms">{switchTo.label}</a>
    )}
  </nav>
  <a href="/request-assessment" class="mobile-menu-item btn-primary relative w-full justify-center" style="transition-delay:240ms">Pyydä arviointi</a>
</div>

<script>
  const header = document.getElementById("site-header");
  const headerInner = document.getElementById("header-inner");

  const onScroll = () => {
    if (!header || !headerInner) return;
    if (window.scrollY > 24) {
      header.classList.add("glass-nav", "border-rsd-border");
      headerInner.classList.add("py-3.5");
      headerInner.classList.remove("py-5");
    } else {
      header.classList.remove("glass-nav", "border-rsd-border");
      headerInner.classList.remove("py-3.5");
      headerInner.classList.add("py-5");
    }
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconBurger = document.getElementById("icon-burger");
  const iconClose = document.getElementById("icon-close");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
    iconBurger?.classList.toggle("hidden", isOpen);
    iconClose?.classList.toggle("hidden", !isOpen);
    document.body.classList.toggle("overflow-hidden", isOpen);
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
      iconBurger?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      document.body.classList.remove("overflow-hidden");
    });
  });
</script>
