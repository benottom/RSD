---
import ResourceCard from "./ResourceCard.astro";
import { reports, whitepapers, caseStudies } from "../data/resources";

const featured = [
  { item: reports[0], href: `/resources/reports/${reports[0].slug}`, cta: "Read the Report" },
  { item: whitepapers[0], href: `/resources/whitepapers/${whitepapers[0].slug}`, cta: "Read the Whitepaper" },
  { item: caseStudies[0], href: `/resources/case-studies/${caseStudies[0].slug}`, cta: "View Case Study" },
];
---

<section class="border-b border-rsd-border bg-rsd-surface-alt py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <div class="max-w-xl">
        <p class="eyebrow mb-4">Intelligence</p>
        <h2 class="font-display text-4xl font-bold text-rsd-heading sm:text-5xl">Field research from the front lines of defense.</h2>
      </div>
      <a href="/resources" class="btn-ghost shrink-0">Browse All Resources</a>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 lg:grid-cols-3">
      {featured.map((f) => (
        <ResourceCard item={f.item} href={f.href} ctaLabel={f.cta} />
      ))}
    </div>

    <a href="/nis2-readiness-check" class="glow-border group mt-6 flex flex-col items-start justify-between gap-4 rounded-lg border border-rsd-border bg-rsd-surface p-8 sm:flex-row sm:items-center">
      <div>
        <p class="eyebrow">Free Self-Assessment</p>
        <h3 class="mt-2 font-display text-xl font-semibold text-rsd-heading">Check your NIS2 &amp; CRA exposure in 12 questions.</h3>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-rsd-body">Not ready to talk to us yet? Get an instant risk tier — no form required to see your result.</p>
      </div>
      <span class="inline-flex shrink-0 items-center gap-2 text-sm font-semibold text-rsd-cyan">
        Start the Check
        <svg class="transition-transform group-hover:translate-x-1" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </a>
  </div>
</section>
